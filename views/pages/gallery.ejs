  <!-- LIGHTBOX MODAL -->
  <div class="modal-backdrop lightbox-modal" id="gallery-lightbox-modal">
    <div class="modal-box" style="background: transparent; border: none;">
      <div style="text-align: right; margin-bottom: 10px;">
        <button class="modal-close-btn" style="background: rgba(255,255,255,0.2); color: #fff; width: 36px; height: 36px;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <img src="" alt="Prest Loans Moment" id="lightbox-img" class="lightbox-img-view">
      <div id="lightbox-caption" style="color: #ffffff; text-align: center; margin-top: 14px; font-weight: 700; font-size: 1.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8);"></div>
