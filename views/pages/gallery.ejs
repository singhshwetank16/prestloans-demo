<!-- PAGE HERO BANNER -->
  <section class="page-banner">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <i class="fa-solid fa-chevron-right" style="font-size: 0.65rem;"></i> <a href="/media">Media</a> <i class="fa-solid fa-chevron-right" style="font-size: 0.65rem;"></i> <span>Photo Gallery</span>
      </div>
      <h1 class="page-banner-title">Prest Loans Moments</h1>
      <p class="page-banner-sub">
        A visual showcase of our people, leadership forums, branch expansions, and memorable celebrations.
      </p>
    </div>
  </section>

