<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : (site.name + ' | Digital Lending Platform | RBI Registered NBFC') %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : (site.name + ' (' + site.legalName + ') is an RBI registered NBFC providing fast, paperless business loans, home loans, education loans, and personal loans across India.') %>">
  <meta name="keywords" content="Prest Loans, NBFC, Business Loan, Home Loan, Education Loan, Personal Loan, Short Term Personal Loan, Lord Krishna Financial Services, EMI Calculator, Fast Loan Approval">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/logo/logo.png">

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof extraStyles !== 'undefined' && extraStyles) { %>
    <%- extraStyles %>
  <% } %>
</head>
<body <%= typeof bodyClass !== 'undefined' ? ('class="' + bodyClass + '"') : '' %>>
