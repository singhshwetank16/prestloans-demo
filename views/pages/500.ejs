<%- include('../partials/_head', { title: '500 - Internal Server Error | Prest Loans' }) %>
<%- include('../partials/_topbar') %>
<%- include('../partials/_header', { activePage: '' }) %>

<section class="section" style="padding: 120px 0 80px; text-align: center; min-height: 60vh; display: flex; align-items: center;">
  <div class="container">
    <div style="max-width: 650px; margin: 0 auto; background: #ffffff; border-radius: 20px; padding: 48px 32px; box-shadow: 0 15px 40px rgba(0,0,0,0.06); border: 1px solid #f1f5f9;">
      <div style="font-size: 5rem; font-weight: 800; color: #dc2626; line-height: 1; margin-bottom: 16px;">
        500
      </div>
      <h1 style="font-size: 1.8rem; color: #1e293b; margin-bottom: 14px; font-weight: 700;">
        Internal Server Error
      </h1>
      <p style="color: #64748b; font-size: 1.05rem; line-height: 1.6; margin-bottom: 30px;">
        Our team has been notified and we are working to resolve the issue. Please try again shortly.
      </p>
      <% if (typeof error !== 'undefined' && error && error.message) { %>
        <pre style="text-align: left; background: #f8fafc; padding: 14px; border-radius: 8px; font-size: 0.85rem; color: #dc2626; overflow-x: auto; margin-bottom: 24px;"><%= error.message %></pre>
      <% } %>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn-primary" style="padding: 12px 28px; border-radius: 50px; font-weight: 600;">
          <i class="fa-solid fa-house"></i> Return Home
        </a>
        <a href="/contact" class="btn-secondary" style="padding: 12px 28px; border-radius: 50px; font-weight: 600; border: 1px solid #cbd5e1; color: #334155;">
          <i class="fa-solid fa-headset"></i> Contact Support
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/_footer') %>
<%- include('../partials/_floating') %>
<%- include('../partials/_modals') %>
<%- include('../partials/_scripts') %>
