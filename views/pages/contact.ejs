  <!-- CONTACT GRID SECTION -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Details Card -->
        <div class="contact-card-box">
          <span class="section-tag" style="margin-bottom: 12px;">Get In Touch</span>
          <h2 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin-bottom: 20px;">Corporate & Registered Headquarters</h2>
          <p style="color: #475569; font-size: 0.9375rem; line-height: 1.7; margin-bottom: 28px;">
            Whether you have an inquiry regarding home loans, personal loans, partner onboarding, or customer support, our executive team is here to assist.
          </p>

          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #fdf2f8; color: var(--primary-purple); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                <i class="fa-solid fa-building"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Corporate Office</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  Lord Krishna Financial Services Ltd (Prest Loans)<br>
                  903, 9th Floor, Surya Kiran Building, KG Marg,<br>
                  Connaught Place, New Delhi - 110001
                </p>
              </div>
            </div>

            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--primary-purple-light); color: var(--primary-purple); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Registered Office</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  Lord Krishna Financial Services Ltd (Prest Loans)<br>
                  M5-M6, Essel House, 10 Asaf Ali Road, New Delhi - 110002
                </p>
              </div>
            </div>

            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--primary-orange-light); color: var(--primary-orange); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Customer Helpline</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  <a href="tel:+911145241131" style="color: #0f172a; font-weight: 600;">011-45241131</a> / 
                  <a href="tel:+911145241123" style="color: #0f172a; font-weight: 600;">011-45241123</a>
                </p>
              </div>
            </div>

            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                <i class="fa-solid fa-clock"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Service Timings</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  Mon - Fri (10:00 AM to 06:30 PM)<br>
                  Saturday (10:00 AM to 03:30 PM)<br>
                  <span style="display: inline-block; background: #fee2e2; color: #dc2626; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-top: 4px;">Second Saturday Off</span>
                </p>
              </div>
            </div>

            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #ecfdf5; color: #25d366; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0;">
                <i class="fa-brands fa-whatsapp"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Official WhatsApp Support</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  <a href="https://wa.me/919711669090?text=Hello%20Prest%20Loans,%20I%20have%20an%20inquiry." target="_blank" rel="noopener" style="color: #059669; font-weight: 700;">
                    +91-9711669090
                  </a>
                </p>
              </div>
            </div>

            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #f1f5f9; color: #334155; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <h4 style="font-weight: 800; color: #0f172a; font-size: 1rem;">Email Support</h4>
                <p style="color: #475569; font-size: 0.875rem; line-height: 1.6;">
                  General Queries: <a href="mailto:info@prestloans.com" style="color: var(--primary-purple); font-weight: 600;">info@prestloans.com</a><br>
                  Grievance Desk: <a href="mailto:nodalofficer@prestloans.com" style="color: var(--primary-purple); font-weight: 600;">nodalofficer@prestloans.com</a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form Box -->
        <div class="contact-card-box">
          <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 6px;">Send Us an Official Message</h3>
          <p style="color: #64748b; font-size: 0.875rem; margin-bottom: 24px;">Fill in the form below and our relationship team will reach out within 4 business hours.</p>

          <form id="main-contact-form">
            <div class="quick-input-group">
              <label class="quick-input-label">Full Name</label>
              <input type="text" id="contact-name" class="quick-input-field" placeholder="Enter Your Name" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
              <div class="quick-input-group">
                <label class="quick-input-label">Contact Number</label>
                <input type="tel" id="contact-phone" class="quick-input-field" placeholder="10-digit mobile number" pattern="[0-9]{10}" required>
              </div>
              <div class="quick-input-group">
                <label class="quick-input-label">Email Address</label>
                <input type="email" id="contact-email" class="quick-input-field" placeholder="name@domain.com" required>
              </div>
            </div>

            <div class="quick-input-group">
              <label class="quick-input-label">Location / City</label>
              <input type="text" id="contact-city" class="quick-input-field" placeholder="e.g. New Delhi, Jaipur, Ludhiana">
            </div>

            <div class="quick-input-group">
              <label class="quick-input-label">Inquiry Subject</label>
              <select id="contact-subject" class="quick-input-field">
                <option value="Business Loan Inquiry">Business Loan Inquiry</option>
                <option value="Home Loan Inquiry">Home Loan Inquiry</option>
                <option value="Education Loan Inquiry">Education Loan Inquiry</option>
                <option value="Personal Loan Inquiry">Personal Loan Inquiry</option>
                <option value="Short Term Loan Inquiry">Short Term Personal Loan Inquiry</option>
                <option value="Partnership / DSA">DSA & Partner Registration</option>
                <option value="Customer Support">Existing Loan Support / Statement</option>
                <option value="Grievance">Grievance / Feedback</option>
              </select>
            </div>

            <div class="quick-input-group">
              <label class="quick-input-label">Message / Details</label>
              <textarea id="contact-msg" class="quick-input-field" style="min-height: 90px; resize: vertical;" placeholder="Tell us how we can help you..."></textarea>
            </div>

            <button type="submit" class="btn-card-submit">
              <span>Send Message</span> <i class="fa-solid fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

