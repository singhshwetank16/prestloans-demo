  <!-- TOP ANNOUNCEMENT BAR -->
  <div class="top-bar">
    <div class="container">
      <div class="top-bar-left">
        <span class="rbi-badge-pill">
          <i class="fa-solid fa-shield-halved"></i> RBI REGISTERED NBFC: <%= site.rbiRegNo %>
        </span>
        <span class="top-link">
          <i class="fa-solid fa-building"></i> <%= site.legalName %> (Est. <%= site.established %>)
        </span>
      </div>
      <div class="top-bar-right">
        <a href="<%= site.contact.phones[0].href %>" class="top-link"><i class="fa-solid fa-phone"></i> <%= site.contact.phones[0].display %></a>
        <a href="mailto:<%= site.contact.emails.support %>" class="top-link"><i class="fa-solid fa-envelope"></i> <%= site.contact.emails.support %></a>
        <a href="javascript:void(0)" onclick="openTrackStatusModal()" class="top-link" style="color: #ff8c61;">
          <i class="fa-solid fa-location-crosshairs"></i> Track Loan Status
        </a>
        <div class="top-bar-socials">
          <% site.socials.forEach(function(s) { %>
          <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" class="top-social-btn <%= s.key %>" title="<%= s.name %>" aria-label="<%= s.name %>"><i class="<%= s.icon %>"></i></a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
