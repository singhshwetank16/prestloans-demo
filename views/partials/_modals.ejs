<!-- ==========================================================================
     GLOBAL REUSABLE MODALS & DIALOGS
     ========================================================================== -->

<!-- ==========================================================================
       MODAL 1: POLICY VIEWER MODAL
       ========================================================================== -->
  <div class="modal-backdrop" id="policy-modal">
    <div class="modal-box">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <h3 id="policy-modal-title">Regulatory Policy</h3>
          <p id="policy-modal-date">RBI Compliance Document</p>
        </div>
        <button class="modal-close-btn" onclick="closePolicyModal()" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body" id="policy-modal-body">
        <!-- Content injected dynamically via policies.js -->
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       MODAL 2: MULTI-STEP LOAN APPLICATION MODAL
       ========================================================================== -->
  <div class="modal-backdrop" id="loan-app-modal">
    <div class="modal-box" style="max-width: 620px;">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <h3>Apply for Digital Loan</h3>
          <p>48-Hour Approval • Paperless Digital Process</p>
        </div>
        <button class="modal-close-btn" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="modal-body">
        <!-- Step Indicators -->
        <div class="application-steps-indicator">
          <div class="app-step active" id="step-ind-1">
            <span class="app-step-num">1</span>
            <span class="app-step-name">Personal Info</span>
          </div>
          <div class="app-step" id="step-ind-2">
            <span class="app-step-num">2</span>
            <span class="app-step-name">Loan Details</span>
          </div>
          <div class="app-step" id="step-ind-3">
            <span class="app-step-num">3</span>
            <span class="app-step-name">Confirmation</span>
          </div>
        </div>

        <!-- Step 1 Form -->
        <div id="app-step-1-content">
          <div class="quick-input-group">
            <label class="quick-input-label">Full Name (As per PAN)</label>
            <input type="text" id="app-full-name" class="quick-input-field" placeholder="Enter Full Name" required>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="quick-input-group">
              <label class="quick-input-label">Mobile Number</label>
              <input type="tel" id="app-phone" class="quick-input-field" placeholder="10-digit number"
                pattern="[0-9]{10}" required>
            </div>
            <div class="quick-input-group">
              <label class="quick-input-label">Email Address</label>
              <input type="email" id="app-email" class="quick-input-field" placeholder="name@domain.com" required>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="quick-input-group">
              <label class="quick-input-label">City / State</label>
              <input type="text" id="app-city" class="quick-input-field" placeholder="e.g. New Delhi">
            </div>
            <div class="quick-input-group">
              <label class="quick-input-label">Pin Code</label>
              <input type="text" id="app-pincode" class="quick-input-field" placeholder="6-digit pincode" maxlength="6">
            </div>
          </div>
          <button type="button" id="btn-next-step-2" class="btn-card-submit" style="margin-top: 14px;">
            <span>Next: Loan Details</span> <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>

        <!-- Step 2 Form -->
        <div id="app-step-2-content" style="display: none;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="quick-input-group">
              <label class="quick-input-label">Select Loan Product</label>
              <select id="app-loan-product" class="quick-input-field">
                <option value="Coaching/Skill Development/Education Loans">Coaching/Skill Development/Education Loans
                </option>
                <option value="Personal Loan">Personal Loan</option>
                <option value="Short Term Personal Loan">Short Term Personal Loan</option>
                <option value="Home Loan">Home Loan</option>
                <option value="Business Loan">Business Loan</option>
              </select>
            </div>
            <div class="quick-input-group">
              <label class="quick-input-label">Loan Amount (₹)</label>
              <input type="number" id="app-loan-amount" class="quick-input-field" value="500000" min="50000"
                max="5000000">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="quick-input-group">
              <label class="quick-input-label">PAN Card Number</label>
              <input type="text" id="app-pan" class="quick-input-field" placeholder="ABCDE1234F"
                style="text-transform: uppercase;" maxlength="10" required>
            </div>
            <div class="quick-input-group">
              <label class="quick-input-label">Employment Type</label>
              <select id="app-biz-type" class="quick-input-field">
                <option value="Salaried">Salaried Professional</option>
                <option value="Self-Employed">Self Employed Professional</option>
                <option value="Student">Student / Parent</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="quick-input-group">
            <label class="quick-input-label">Annual Income (Approx ₹)</label>
            <select id="app-turnover" class="quick-input-field">
              <option value="3-6L">₹3 Lakhs - ₹6 Lakhs</option>
              <option value="6-12L">₹6 Lakhs - ₹12 Lakhs</option>
              <option value="12-25L">₹12 Lakhs - ₹25 Lakhs</option>
              <option value="25L+">Above ₹25 Lakhs</option>
            </select>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 14px;">
            <button type="button" onclick="goToAppStep(1)" class="btn-secondary"
              style="flex: 0.8; justify-content: center;">Back</button>
            <button type="button" id="btn-submit-loan-app" class="btn-card-submit" style="flex: 1.2;">
              <span>Submit Application</span> <i class="fa-solid fa-check"></i>
            </button>
          </div>
        </div>

        <!-- Step 3 Confirmation -->
        <div id="app-step-3-content" style="display: none; text-align: center; padding: 20px 10px;">
          <div
            style="width: 70px; height: 70px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 20px;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Application Submitted
            Successfully!</h3>
          <p style="color: #64748b; font-size: 0.9375rem; margin-bottom: 20px;">
            Your loan application has been registered successfully. Our automated underwriting desk and credit
            specialists are currently reviewing your details.
          </p>
          <div
            style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 10px; padding: 14px; margin-bottom: 24px;">
            <span style="font-size: 0.8125rem; color: #64748b; display: block; margin-bottom: 4px;">Application
              Reference Number:</span>
            <strong id="app-generated-id"
              style="font-size: 1.35rem; color: #70146e; letter-spacing: 1px;">PL-2026-849201</strong>
          </div>
          <button type="button" class="btn-primary" style="margin: 0 auto;"
            onclick="document.getElementById('loan-app-modal').classList.remove('active'); document.body.style.overflow='';">
            Done / Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       MODAL 3: LOGIN PORTAL (BORROWER, PARTNER, EMPLOYEE)
       ========================================================================== -->
  <div class="modal-backdrop" id="login-modal">
    <div class="modal-box" style="max-width: 480px;">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <h3>Prest Loans Portal</h3>
          <p>Select your user category to proceed</p>
        </div>
        <button class="modal-close-btn" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div style="display: flex; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
        <button id="tab-btn-customer" class="login-tab-btn active" onclick="switchLoginTab('customer')"
          style="flex: 1; padding: 12px; border: none; background: none; font-weight: 700; color: #70146e; border-bottom: 3px solid #70146e; cursor: pointer;">
          Borrower
        </button>
        <button id="tab-btn-partner" class="login-tab-btn" onclick="switchLoginTab('partner')"
          style="flex: 1; padding: 12px; border: none; background: none; font-weight: 600; color: #64748b; cursor: pointer;">
          Partner / DSA
        </button>
        <button id="tab-btn-employee" class="login-tab-btn" onclick="switchLoginTab('employee')"
          style="flex: 1; padding: 12px; border: none; background: none; font-weight: 600; color: #64748b; cursor: pointer;">
          Employee
        </button>
      </div>

      <div class="modal-body">
        <!-- Borrower Login -->
        <div id="tab-content-customer" class="login-tab-content">
          <form id="customer-login-form">
            <div class="quick-input-group">
              <label class="quick-input-label">Registered Mobile Number</label>
              <input type="tel" id="login-mobile" class="quick-input-field" placeholder="10-digit number"
                pattern="[0-9]{10}" required>
            </div>
            <button type="submit" class="btn-card-submit">
              <span>Send Secure OTP</span> <i class="fa-solid fa-key"></i>
            </button>
          </form>
          <p style="font-size: 0.75rem; color: #64748b; margin-top: 16px; text-align: center;">
            <i class="fa-solid fa-lock"></i> Protected by 256-bit bank grade encryption
          </p>
        </div>

        <!-- Partner Login -->
        <div id="tab-content-partner" class="login-tab-content" style="display: none;">
          <div class="quick-input-group">
            <label class="quick-input-label">Partner Code / Email</label>
            <input type="text" class="quick-input-field" placeholder="e.g. DSA-DELHI-102">
          </div>
          <div class="quick-input-group">
            <label class="quick-input-label">Password</label>
            <input type="password" class="quick-input-field" placeholder="••••••••">
          </div>
          <button type="button" class="btn-card-submit"
            onclick="showToast('Partner login validated. Redirecting to CRM dashboard...')">
            Partner Login
          </button>
        </div>

        <!-- Employee Login -->
        <div id="tab-content-employee" class="login-tab-content" style="display: none;">
          <div class="quick-input-group">
            <label class="quick-input-label">Work Email (@prestloans.com)</label>
            <input type="email" class="quick-input-field" placeholder="employee@prestloans.com">
          </div>
          <div class="quick-input-group">
            <label class="quick-input-label">Single Sign-On (SSO) Pin</label>
            <input type="password" class="quick-input-field" placeholder="••••••">
          </div>
          <button type="button" class="btn-card-submit"
            onclick="showToast('Employee SSO authenticated. Loading internal LOS/LMS...')">
            Employee SSO Login
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       MODAL 4: TRACK STATUS MODAL
       ========================================================================== -->
  <div class="modal-backdrop" id="track-status-modal">
    <div class="modal-box" style="max-width: 500px;">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <h3>Track Loan Application</h3>
          <p>Get real-time updates on your loan status</p>
        </div>
        <button class="modal-close-btn" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body">
        <form id="track-status-form">
          <div class="quick-input-group">
            <label class="quick-input-label">Application Reference ID or Mobile Number</label>
            <input type="text" id="track-input" class="quick-input-field"
              placeholder="e.g. PL-2026-849201 or 9876543210" required>
          </div>
          <button type="submit" class="btn-card-submit">
            <i class="fa-solid fa-magnifying-glass"></i> <span>Search Status</span>
          </button>
        </form>

        <div id="track-result-box" style="display: none;"></div>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       MODAL 5: GALLERY LIGHTBOX MODAL
       ========================================================================== -->
  <div class="modal-backdrop lightbox-modal" id="gallery-lightbox-modal">
    <div class="modal-box" style="background: transparent; border: none;">
      <div style="text-align: right; margin-bottom: 10px;">
        <button class="modal-close-btn"
          style="background: rgba(255,255,255,0.2); color: #fff; width: 36px; height: 36px;"
          aria-label="Close Lightbox">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <img src="" alt="Prest Loans Moment" id="lightbox-img" class="lightbox-img-view">
      <div id="lightbox-caption"
        style="color: #ffffff; text-align: center; margin-top: 14px; font-weight: 700; font-size: 1.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
      </div>
    </div>
  </div>
