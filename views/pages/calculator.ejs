<%- include('../partials/_head') %>
<%- include('../partials/_topbar') %>
<%- include('../partials/_header') %>

<!-- PAGE HERO BANNER -->
  <section class="page-banner">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> <i class="fa-solid fa-chevron-right" style="font-size: 0.65rem;"></i> <span>EMI Calculator</span>
      </div>
      <h1 class="page-banner-title">Interactive Loan Calculator</h1>
      <p class="page-banner-sub">
        Plan your loan finances with accuracy. Calculate exact equated monthly installments, total interest, and repayment schedules in real-time.
      </p>
    </div>
  </section>

  <!-- ==========================================================================
       LOAN CALCULATOR SECTION (MATCHING SCREENSHOT 3)
       ========================================================================== -->
  <section class="calculator-section" id="calculator">
    <div class="calc-ambient-orb orb-1"></div>
    <div class="calc-ambient-orb orb-2"></div>
    <div class="container">
      <div class="calc-header-center">
        <div class="calc-badge">
          <span class="calc-badge-dot"></span>
          <span>SMART FINANCIAL SIMULATOR</span>
        </div>
        <h2 class="calc-title-main">How Much Capital Do You Need?</h2>
        <p class="calc-desc-sub">
          Instant EMI forecasting with 100% transparent reducing-balance calculation & zero hidden surprises.
        </p>

        <!-- Product Selector Switcher -->
        <div class="calc-product-tabs" role="tablist">
          <button type="button" class="calc-product-tab active" data-loan-type="education" data-rate="12" data-tenure="2">
            <i class="fa-solid fa-graduation-cap"></i> Education Loan (12%)
          </button>
          <button type="button" class="calc-product-tab" data-loan-type="personal" data-rate="18" data-tenure="1">
            <i class="fa-solid fa-user-shield"></i> Personal Loan (18%)
          </button>
          <button type="button" class="calc-product-tab" data-loan-type="short-term" data-rate="24" data-tenure="1">
            <i class="fa-solid fa-clock-rotate-left"></i> Short Term Personal Loan
          </button>
          <button type="button" class="calc-product-tab" data-loan-type="home" data-rate="9.5" data-tenure="10">
            <i class="fa-solid fa-house-chimney"></i> Home Loan (9.5%)
          </button>
          <button type="button" class="calc-product-tab" data-loan-type="business" data-rate="14" data-tenure="3">
            <i class="fa-solid fa-briefcase"></i> Business Loan (14%)
          </button>
        </div>
      </div>

      <!-- Studio Card: 2-Column Split -->
      <div class="calc-studio-card">
        <div class="calc-studio-grid">
          <!-- LEFT COLUMN: Interactive Sliders & Inputs -->
          <div class="calc-controls-col">
            <!-- Control 1: Loan Amount -->
            <div class="calc-control-group">
              <div class="calc-control-top">
                <div class="calc-field-info">
                  <span class="calc-field-icon"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                  <label for="calc-amount-input" class="calc-field-title">Required Loan Amount</label>
                </div>
                <div class="calc-val-badge">
                  <span class="currency-symbol">₹</span>
                  <input type="text" id="calc-amount-input" class="calc-input-field" placeholder="500000" value="500000">
                </div>
              </div>

              <!-- Slider -->
              <div class="slider-wrapper">
                <input type="range" id="calc-amount-slider" class="slider-range" min="50000" max="5000000" step="25000" value="500000">
                <div class="slider-limits">
                  <span>₹ 50 Thousand</span>
                  <span>₹ 50 Lakh</span>
                </div>
              </div>

              <!-- Quick Amount Chips -->
              <div class="calc-preset-chips" data-target="amount">
                <button type="button" class="calc-chip-btn" data-val="100000">₹1 Lakh</button>
                <button type="button" class="calc-chip-btn" data-val="300000">₹3 Lakh</button>
                <button type="button" class="calc-chip-btn active" data-val="500000">₹5 Lakh</button>
                <button type="button" class="calc-chip-btn" data-val="1000000">₹10 Lakh</button>
                <button type="button" class="calc-chip-btn" data-val="2500000">₹25 Lakh</button>
                <button type="button" class="calc-chip-btn" data-val="5000000">₹50 Lakh</button>
              </div>
            </div>

            <!-- Control 2: Interest Rate -->
            <div class="calc-control-group">
              <div class="calc-control-top">
                <div class="calc-field-info">
                  <span class="calc-field-icon"><i class="fa-solid fa-percent"></i></span>
                  <label for="calc-rate-input" class="calc-field-title">Interest Rate (% p.a.)</label>
                </div>
                <div class="calc-val-badge">
                  <input type="text" id="calc-rate-input" class="calc-input-field" placeholder="9.5" value="9.5">
                  <span class="percent-symbol">%</span>
                </div>
              </div>

              <!-- Slider -->
              <div class="slider-wrapper">
                <input type="range" id="calc-rate-slider" class="slider-range" min="8" max="30" step="0.5" value="9.5">
                <div class="slider-limits">
                  <span>8% Minimum</span>
                  <span>30% Maximum</span>
                </div>
              </div>

              <!-- Quick Rate Chips -->
              <div class="calc-preset-chips" data-target="rate">
                <button type="button" class="calc-chip-btn active" data-val="9.5">9.5% (Home)</button>
                <button type="button" class="calc-chip-btn" data-val="12">12%</button>
                <button type="button" class="calc-chip-btn" data-val="14">14%</button>
                <button type="button" class="calc-chip-btn" data-val="18">18%</button>
                <button type="button" class="calc-chip-btn" data-val="24">24%</button>
              </div>
            </div>

            <!-- Control 3: Loan Tenure -->
            <div class="calc-control-group">
              <div class="calc-control-top">
                <div class="calc-field-info">
                  <span class="calc-field-icon"><i class="fa-regular fa-calendar-check"></i></span>
                  <label for="calc-tenure-input" class="calc-field-title">Loan Duration / Tenure</label>
                </div>
                <div class="calc-val-badge">
                  <input type="text" id="calc-tenure-input" class="calc-input-field" placeholder="10" value="10">
                  <span class="tenure-unit">Years</span>
                  <span class="tenure-months-badge" id="calc-tenure-months">(120 Mo)</span>
                </div>
              </div>

              <!-- Slider -->
              <div class="slider-wrapper">
                <input type="range" id="calc-tenure-slider" class="slider-range" min="1" max="20" step="1" value="10">
                <div class="slider-limits">
                  <span>1 Year</span>
                  <span>20 Years</span>
                </div>
              </div>

              <!-- Quick Tenure Chips -->
              <div class="calc-preset-chips" data-target="tenure">
                <button type="button" class="calc-chip-btn" data-val="1">1 Year</button>
                <button type="button" class="calc-chip-btn" data-val="3">3 Years</button>
                <button type="button" class="calc-chip-btn" data-val="5">5 Years</button>
                <button type="button" class="calc-chip-btn active" data-val="10">10 Years</button>
                <button type="button" class="calc-chip-btn" data-val="20">20 Years</button>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Realtime Results & Visual Donut Analytics -->
          <div class="calc-results-col">
            <!-- Hero Monthly EMI Display -->
            <div class="calc-hero-emi-card">
              <div class="calc-hero-top">
                <span class="calc-hero-badge"><i class="fa-solid fa-bolt-lightning"></i> MONTHLY OUTFLOW</span>
                <span class="calc-reducing-tag">Reducing Rate EMI</span>
              </div>
              <div class="calc-hero-amount-row">
                <span class="calc-hero-value" id="calc-emi-result">₹ 17,089</span>
                <span class="calc-hero-unit">/ month</span>
              </div>
              <p class="calc-hero-note">Zero advance installments • Direct auto-debit via e-NACH mandate</p>
            </div>

            <!-- Interactive Donut Breakdown -->
            <div class="calc-breakdown-card">
              <div class="calc-donut-wrap">
                <svg class="calc-donut-chart" viewBox="0 0 100 100">
                  <circle class="donut-bg" cx="50" cy="50" r="42" />
                  <circle class="donut-interest" id="donut-interest-circle" cx="50" cy="50" r="42" />
                  <circle class="donut-principal" id="donut-principal-circle" cx="50" cy="50" r="42" />
                </svg>
                <div class="donut-center-info">
                  <span class="donut-center-ratio" id="donut-center-ratio">70%</span>
                  <span class="donut-center-sub">Principal</span>
                </div>
              </div>

              <!-- Donut Legends -->
              <div class="calc-donut-legend">
                <div class="legend-item">
                  <div class="legend-title">
                    <span class="legend-dot principal"></span>
                    <span>Principal Amount</span>
                  </div>
                  <span class="legend-val" id="calc-principal-display">₹ 5,00,000</span>
                  <span class="legend-pct" id="ratio-p">70%</span>
                </div>
                <div class="legend-item">
                  <div class="legend-title">
                    <span class="legend-dot interest"></span>
                    <span>Total Interest</span>
                  </div>
                  <span class="legend-val" id="calc-interest-result">₹ 1,15,204</span>
                  <span class="legend-pct" id="ratio-i">30%</span>
                </div>
              </div>
            </div>

            <!-- Summary Total Payable -->
            <div class="calc-total-pay-box">
              <div class="total-pay-info">
                <span class="total-pay-label">Total Amount Payable</span>
                <span class="total-pay-sub">(Principal + Interest over selected tenure)</span>
              </div>
              <span class="total-pay-value" id="calc-total-result">₹ 6,15,204</span>
            </div>

            <!-- Hidden elements for backward compatibility -->
            <div style="display: none;" aria-hidden="true">
              <div id="breakdown-bar-p"></div>
              <div id="breakdown-bar-i"></div>
            </div>

            <!-- Apply Button -->
            <button id="calc-apply-btn" class="btn-calc-apply">
              <span>Apply For This Loan</span>
              <i class="fa-solid fa-arrow-right"></i>
            </button>

            <!-- Trust Badges -->
            <div class="calc-trust-strip">
              <div class="calc-trust-item"><i class="fa-solid fa-circle-check"></i> 48-Hour Disbursal</div>
              <div class="calc-trust-item"><i class="fa-solid fa-shield-halved"></i> RBI Regulated NBFC</div>
              <div class="calc-trust-item"><i class="fa-solid fa-file-shield"></i> Zero Hidden Fees</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TENURE COMPARISON & AMORTIZATION TABLE -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Smart Financial Planning</span>
        <h2 class="section-title">Loan Amortization & Tenure Breakdown</h2>
        <p class="section-desc">Observe how choosing different tenures affects your monthly outflow and total cumulative interest cost.</p>
      </div>

      <!-- Amortization Schedule Table -->
      <div class="amortization-wrap">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 16px;">
          <i class="fa-solid fa-table-list" style="color: var(--primary-purple);"></i> Indicative Year-by-Year Repayment Schedule (For Selected Values)
        </h3>
        <table class="amortization-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>Opening Balance</th>
              <th>Annual EMI Paid</th>
              <th>Principal Repaid</th>
              <th>Interest Repaid</th>
              <th>Closing Balance</th>
            </tr>
          </thead>
          <tbody id="amortization-tbody">
            <tr>
              <td><strong>Year 1</strong></td>
              <td>₹ 5,00,000</td>
              <td>₹ 2,05,068</td>
              <td>₹ 1,42,200</td>
              <td>₹ 62,868</td>
              <td>₹ 3,57,800</td>
            </tr>
            <tr>
              <td><strong>Year 2</strong></td>
              <td>₹ 3,57,800</td>
              <td>₹ 2,05,068</td>
              <td>₹ 1,63,550</td>
              <td>₹ 41,518</td>
              <td>₹ 1,94,250</td>
            </tr>
            <tr>
              <td><strong>Year 3</strong></td>
              <td>₹ 1,94,250</td>
              <td>₹ 2,05,068</td>
              <td>₹ 1,94,250</td>
              <td>₹ 10,818</td>
              <td>₹ 0.00</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- EMI Formula Explanation -->
      <div style="background: #f8fafc; border-radius: var(--radius-lg); border: 1px solid #e2e8f0; padding: 32px; margin-top: 40px;">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 10px;">
          <i class="fa-solid fa-calculator" style="color: var(--primary-orange);"></i> Standard EMI Mathematical Formula
        </h3>
        <p style="color: #475569; font-size: 0.9375rem; line-height: 1.8; margin-bottom: 14px;">
          All Indian banks and RBI-registered NBFCs compute standard Equated Monthly Installment (EMI) using the reducing balance method formula:
        </p>
        <div style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: var(--radius-md); padding: 14px 20px; font-family: monospace; font-size: 1.1rem; color: #70146e; font-weight: 700; display: inline-block; margin-bottom: 14px;">
          EMI = [P × R × (1+R)^N] / [(1+R)^N - 1]
        </div>
        <p style="color: #64748b; font-size: 0.875rem;">
          Where <strong>P</strong> = Principal Loan Amount, <strong>R</strong> = Monthly Interest Rate (Annual Rate / 12 / 100), and <strong>N</strong> = Number of monthly installments.
        </p>
      </div>
    </div>
  </section>

  <!-- FOOTER (Matching Screenshot 2) -->

<%- include('../partials/_footer') %>
<%- include('../partials/_floating') %>
<%- include('../partials/_modals') %>
<%- include('../partials/_scripts') %>
