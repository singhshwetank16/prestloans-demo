  <!-- MAIN HEADER -->
  <header class="main-header">
    <div class="header-container">
      <!-- Logo -->
      <a href="/" class="brand-logo-wrap" title="Prest Loans - Digital Lending Platform">
        <img src="/assets/logo/logo.png" alt="Prest Loans - RBI Registered NBFC" class="brand-logo-img">
      </a>

      <!-- Navigation Menu -->
      <nav class="main-nav" id="main-nav">
        <ul class="nav-links">
          <li class="nav-item">
            <a href="/" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">Home</a>
          </li>
          <li class="nav-item">
            <a href="/about" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'about' ? 'active' : '' %>">About</a>
          </li>
          <li class="nav-item dropdown">
            <a href="javascript:void(0)" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>">
              Products <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem;"></i>
            </a>
            <ul class="dropdown-menu">
              <li class="dropdown-item">
                <a href="/products#education-loan">
                  <i class="fa-solid fa-graduation-cap"></i> Coaching/Skill Development/Education Loans
                </a>
              </li>
              <li class="dropdown-item">
                <a href="/products#personal-loan">
                  <i class="fa-solid fa-user-shield"></i> Personal Loan
                </a>
              </li>
              <li class="dropdown-item">
                <a href="/products#short-term-personal-loan">
                  <i class="fa-solid fa-clock-rotate-left"></i> Short Term Personal Loan
                </a>
              </li>
              <li class="dropdown-item">
                <a href="/products#home-loan">
                  <i class="fa-solid fa-house-chimney"></i> Home Loan
                </a>
              </li>
              <li class="dropdown-item">
                <a href="/products#business-loan">
                  <i class="fa-solid fa-briefcase"></i> Business Loan
                </a>
              </li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a href="javascript:void(0)" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'media' ? 'active' : '' %>">
              Media <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem;"></i>
            </a>
            <ul class="dropdown-menu">
              <li class="dropdown-item">
                <a href="/media"><i class="fa-solid fa-newspaper"></i> Press Releases & Coverage</a>
              </li>
              <li class="dropdown-item">
                <a href="/gallery"><i class="fa-solid fa-images"></i> Photo Gallery</a>
              </li>
              <li class="dropdown-item">
                <a href="/blog"><i class="fa-solid fa-newspaper"></i> Insights & Blog</a>
              </li>
            </ul>
          </li>
          <li class="nav-item">
            <a href="/customers-stories" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'customers-stories' ? 'active' : '' %>">Customers' Stories</a>
          </li>
          <li class="nav-item">
            <a href="/career" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'career' ? 'active' : '' %>">Career</a>
          </li>
          <li class="nav-item">
            <a href="/faq" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'faq' ? 'active' : '' %>">FAQ</a>
          </li>
          <li class="nav-item mobile-only-socials">
            <div class="mobile-nav-socials">
              <span class="footer-social-title">Follow Us</span>
              <div class="footer-social-links">
                <% site.socials.forEach(function(s) { %>
                <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" class="footer-social-btn <%= s.key %>" title="<%= s.name %>" aria-label="<%= s.name %>"><i class="<%= s.icon %>"></i></a>
                <% }); %>
              </div>
            </div>
          </li>
        </ul>
      </nav>

      <!-- Actions: Login & Language Dropdown -->
      <div class="header-actions">
        <button class="btn-login" onclick="openLoginModal('customer')">
          Login
        </button>

        <div class="lang-select-wrap">
          <select id="lang-select" class="lang-select" aria-label="Select Language">
            <option value="en">Select Language ▼</option>
            <option value="en">English</option>
            <option value="hi">हिंदी (Hindi)</option>
          </select>
          <i class="fa-solid fa-globe"></i>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button class="mobile-toggle" id="mobile-menu-toggle" aria-label="Open Menu">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </header>
